# ─── Supabase Postgres (Supavisor pooler) ──────────────────────────────────────
# The PORT matters:
#   6543 = transaction pooler -> the running app. No prepared statements,
#          so `?pgbouncer=true` is REQUIRED or Prisma fails intermittently.
#   5432 = session pooler     -> `prisma migrate` only. Migrations cannot run
#          over the transaction pooler.
# Percent-encode the password if it contains  @ : / ? # & %
DATABASE_URL="postgresql://postgres.weqvsmzbsepgtsvnpjjc:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.weqvsmzbsepgtsvnpjjc:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET="<GENERATE_ME>"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Vite dev origin, allowed through CORS in development only
CLIENT_ORIGIN="http://localhost:5173"

# ─── Seed accounts (Phase 1 only) ─────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@quiz.local"
SEED_ADMIN_PASSWORD="change-me-now"
